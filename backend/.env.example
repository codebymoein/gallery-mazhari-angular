# Gallery Mazhari NestJS backend environment example
# Canonical runtime contract. See docs/operations/ENVIRONMENT.md.
# Copy to backend/.env for local use only. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Comma-separated frontend origins.
FRONTEND_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
BACKEND_PUBLIC_URL=http://localhost:3000
# Set true only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false

# Database
# sqlite is local-development compatibility only; production uses postgres.
DB_TYPE=sqlite
# DB_SQLITE_PATH=data/gallery-mazhari.sqlite

# PostgreSQL values are required by the production deployment contract.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=local_development_only
DB_NAME=gallery_mazhari

# Authentication/security
# Development placeholders are intentionally obvious. Production validation
# rejects placeholder JWT values and JWT secrets shorter than 32 characters.
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d
ADMIN_SETUP_KEY=change_this_admin_setup_key

# Media storage
# Development/test may use local storage. Production validation requires s3.
MEDIA_STORAGE_DRIVER=local
MEDIA_S3_ENDPOINT=https://objects.example.com
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=gallery-media
MEDIA_S3_ACCESS_KEY_ID=change_me
MEDIA_S3_SECRET_ACCESS_KEY=change_me
MEDIA_PUBLIC_BASE_URL=https://media.gallery-mazhari.ir

# Media malware scanning
# Local development may explicitly disable scanning. Production validation
# requires http mode and a reachable scanner endpoint; scanner failures fail closed.
MEDIA_MALWARE_SCAN_MODE=disabled
MEDIA_MALWARE_SCAN_URL=http://127.0.0.1:3310/scan

# Password recovery / SMTP
ADMIN_RECOVERY_EMAIL=recovery@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="Gallery Mazhari <no-reply@example.com>"

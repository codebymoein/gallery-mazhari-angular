PORT=3000
# چند دامنه با کاما جدا می‌شوند، مثال: https://test.example.com,http://localhost:4200
FRONTEND_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
BACKEND_PUBLIC_URL=http://localhost:3000
# Set true only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false

# sqlite برای توسعه محلی (بدون نصب دیتابیس)، postgres برای سرور
DB_TYPE=sqlite
# مسیر فایل sqlite (اختیاری — پیش‌فرض: data/gallery-mazhari.sqlite)
# DB_SQLITE_PATH=

# تنظیمات Postgres (وقتی DB_TYPE=postgres باشد)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=gallery_mazhari

JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d
ADMIN_SETUP_KEY=change_this_admin_setup_key

# Password recovery (keep SMTP credentials outside Git)
ADMIN_RECOVERY_EMAIL=recovery@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="Gallery Mazhari <no-reply@example.com>"
NODE_ENV=development

[Unit]
Description=Gallery Mazhari NestJS backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gallerymazhari
Group=gallerymazhari
WorkingDirectory=/srv/gallery-mazhari/current/backend
EnvironmentFile=/etc/gallery-mazhari/backend.env
ExecStart=/usr/bin/env node /srv/gallery-mazhari/current/backend/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/gallery-mazhari

[Install]
WantedBy=multi-user.target

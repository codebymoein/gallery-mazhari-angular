# Non-secret backup contract example. Real credentials belong in the host secret store.
BACKUP_ROOT=/var/backups/gallery-mazhari
BACKUP_RETENTION_DAYS=14
BACKUP_REQUIRE_REMOTE=true
BACKUP_S3_URI=s3://gallery-mazhari-backups/postgres
BACKUP_S3_ENDPOINT=https://backup-objects.example.com
# age recipient is a public encryption recipient, not a private key.
BACKUP_AGE_RECIPIENT=age1replace_with_backup_recipient

# Production media backup. Source and target MUST be separate buckets/accounts or
# otherwise separate failure domains according to the provider design.
MEDIA_BACKUP_SOURCE_URI=s3://gallery-media
MEDIA_BACKUP_TARGET_URI=s3://gallery-mazhari-backups/media
MEDIA_BACKUP_S3_ENDPOINT=https://objects.example.com

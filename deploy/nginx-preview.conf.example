server {
    listen 80;
    listen [::]:80;
    server_name preview.gallerymazhari.com;

    root /var/www/gallery-mazhari-preview/browser;
    index index.html;

    location /api/ {
        proxy_pass https://v2.gallerymazhari.com;
        proxy_ssl_server_name on;
        proxy_ssl_name v2.gallerymazhari.com;
        proxy_set_header Host v2.gallerymazhari.com;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /PREVIEW.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ /index.html;
    }
}

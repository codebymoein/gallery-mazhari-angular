[Unit]
Description=Gallery Mazhari encrypted PostgreSQL and media backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gallerymazhari
Group=gallerymazhari
EnvironmentFile=/etc/gallery-mazhari/backend.env
EnvironmentFile=/etc/gallery-mazhari/backup.env
ExecStart=/srv/gallery-mazhari/current/deploy/backup-postgres.sh
ExecStart=/srv/gallery-mazhari/current/deploy/backup-media.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/gallery-mazhari

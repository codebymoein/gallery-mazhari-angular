# Gallery Mazhari Angular - Environment Variables Example
# Copy this file to .env and update values

# API Configuration
API_BASE_URL=http://localhost:8081
API_PATH=/wp-json
API_TIMEOUT=30000

# WordPress
WP_API_VERSION=v3
WP_REST_NONCE=

# App Settings
APP_NAME=Gallery Mazhari
APP_LANGUAGE=fa
APP_CURRENCY=IRR
APP_TIMEZONE=Asia/Tehran

# Build Configuration
PRODUCTION=false
VERSION=1.0.0-dev

# Feature Flags
FEATURE_DREAM_CANVAS=true
FEATURE_CONSULTATION=true
FEATURE_ENGRAVING=true
FEATURE_REVIEWS=true
FEATURE_WISHLIST=true
FEATURE_COMPARISON=true

# Debugging
DEBUG_API=true
DEBUG_STORAGE=true
DEBUG_STATE=true
DEBUG_ERRORS=true

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600

# Analytics (optional)
ANALYTICS_ID=
SENTRY_DSN=

# Payment Gateway (optional)
STRIPE_KEY=
PAYPAL_CLIENT_ID=

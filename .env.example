# Gallery Mazhari Angular - legacy/frontend compatibility environment example
#
# IMPORTANT:
# - This file is NOT the NestJS production environment contract.
# - Canonical backend/runtime configuration lives in backend/.env.example and
#   docs/operations/ENVIRONMENT.md.
# - Do not place secrets here. Angular/browser-visible configuration is public.
# - WordPress keys below are compatibility-only and MUST NOT become a second
#   product/inventory source of truth.

# Legacy API compatibility
API_BASE_URL=http://localhost:8081
API_PATH=/wp-json
API_TIMEOUT=30000
WP_API_VERSION=v3
WP_REST_NONCE=

# App Settings
APP_NAME=Gallery Mazhari
APP_LANGUAGE=fa
APP_CURRENCY=IRR
APP_TIMEZONE=Asia/Tehran

# Build Configuration
PRODUCTION=false
VERSION=1.0.0-dev

# Feature Flags
FEATURE_DREAM_CANVAS=true
FEATURE_CONSULTATION=true
FEATURE_ENGRAVING=true
FEATURE_REVIEWS=true
FEATURE_WISHLIST=true
FEATURE_COMPARISON=true

# Debugging - local/development only
DEBUG_API=true
DEBUG_STORAGE=true
DEBUG_STATE=true
DEBUG_ERRORS=true

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600

# Public/browser-safe identifiers only
ANALYTICS_ID=
SENTRY_DSN=

# Deprecated compatibility placeholders. Never put private payment credentials
# in Angular/browser environment files.
STRIPE_KEY=
PAYPAL_CLIENT_ID=
